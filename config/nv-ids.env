# Numark NV — canonical USB identity (single source of truth)
#
# This tree ships stock Numark NV factory product IDs so first clone works.
# On install, tools/detect-nv.sh --write rewrites this file from whatever is
# actually plugged into the user's machine (VID/PIDs only — no host paths).
#
# Format: KEY=VALUE, hex digits WITHOUT a 0x prefix.
# Shell-sourceable. Parsed by nv_screens/ids.py for Python consumers.
#
# Re-detect after swapping hardware:
#   tools/detect-nv.sh --write

NV_VID=15e4

# Known Numark NV product IDs (factory)
NV_PID_CONTROL=1005
NV_PID_AUDIO=1033
NV_PID_GRAPHICS=2033
